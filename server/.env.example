# 复制为 server/.env 后填入真实值；server/.env 不入库。
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat
# 允许客户端选择哪些模型（逗号分隔）；留空则一律使用 AI_MODEL。
AI_MODELS=
# 联网工具；两个密钥任一配置即启用 agent 模式，都不配置则仅透传模型回答。
SERPER_KEY=
JINA_KEY=

# bash/python 工具执行：置 true 后模型可在本机跑 shell 命令与 python 代码（取系统状态、验证代码行为）。
# 谨慎打开：该能力只对受控自用有意义，公网暴露面不应启用。
SHELL_TOOLS=false

# 访问口令：留空 = 登录门卫关闭（仅绑 loopback 的自用形态）；
# 服务要暴露到公网时必须配置 —— 全站页面与所有 /api 一律登录后才能访问。
# 例外仅两条：/api/app-version 与 /app/ 下的 APK（老壳 OTA 的 DownloadManager 不带网页 Cookie）。
# 修改口令即让所有已登录会话失效。
ACCESS_PASSWORD=
