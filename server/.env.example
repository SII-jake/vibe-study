# 复制为 server/.env 后填入真实值；server/.env 不入库。

# —— 官方渠道（默认）：对话走 DeepSeek 官方 Messages API（/anthropic/v1/messages），
# 联网搜索、读链接、安全审核、会话标题全部由服务端托管；只需配一个 DEEPSEEK_KEY。
# 在此渠道下 baseUrl/apiKey/model 会自动回退为官方直路（api.deepseek.com/v1 + deepseek-flash），
# /api/title、/api/health 不用额外配置。
DEEPSEEK_KEY=
# 官方端点默认值；自建代理时改成你的地址。
DEEPSEEK_BASE=https://api.deepseek.com

# —— 自编排渠道（可选，通常留空）：显式配置 AI_* 后优先于官方回退，
# /api/title 走该网关；/api/chat 仍走官方渠道（模型固定 deepseek-flash）。
#AI_BASE_URL=
#AI_API_KEY=
#AI_MODEL=
# 允许客户端选择哪些模型（逗号分隔）；留空则一律使用 AI_MODEL。
#AI_MODELS=

# bash/python 工具执行：置 true 后模型可在本机跑 shell 命令与 python 代码（取系统状态、验证代码行为）。
# 谨慎打开：该能力只对受控自用有意义，公网暴露面不应启用。
SHELL_TOOLS=false

# 访问口令：留空 = 登录门卫关闭（仅绑 loopback 的自用形态）；
# 服务要暴露到公网时必须配置 —— 全站页面与所有 /api 一律登录后才能访问。
# 例外仅两条：/api/app-version 与 /app/ 下的 APK（老壳 OTA 的 DownloadManager 不带网页 Cookie）。
# 修改口令即让所有已登录会话失效。
ACCESS_PASSWORD=
