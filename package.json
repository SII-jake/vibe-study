{
  "name": "vibe-study",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "以问答树组织学习内容的个人自用 PWA",
  "scripts": {
    "dev": "node server/index.mjs & rspack serve -c web/rspack.config.ts",
    "dev:api": "node server/index.mjs",
    "start": "node server/index.mjs",
    "build": "tsc -p web/tsconfig.json && NODE_ENV=production rspack build -c web/rspack.config.ts",
    "preview": "node server/index.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p web/tsconfig.json",
    "type:web": "tsc -p web/tsconfig.json",
    "dev:web": "rspack serve -c web/rspack.config.ts",
    "build:web": "NODE_ENV=production rspack build -c web/rspack.config.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/status-bar": "^8.0.4",
    "clsx": "2.1.1",
    "dompurify": "^3.1.6",
    "fflate": "0.8.3",
    "idb": "^8.0.0",
    "katex": "0.16.22",
    "marked": "^14.1.2",
    "mdast-util-find-and-replace": "3.0.2",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "mermaid": "11.10.1",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-llm-math": "3.1.0",
    "prismjs": "1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "4.4.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@rspack/cli": "2.0.2",
    "@rspack/core": "2.0.2",
    "@rspack/dev-server": "2.0.1",
    "@swc/helpers": "0.5.23",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^25.0.0",
    "puppeteer-core": "^25.16.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^2.0.5"
  }
}
